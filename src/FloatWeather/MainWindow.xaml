<Window x:Class="FloatWeather.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="悬浮天气 · 详情"
        Width="408" Height="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- 区块标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextHighBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12,10,16,18">
        <!-- 柔和投影：多层半透明圆角，替代 DropShadowEffect（避免透明窗口的灰色直角） -->
        <Border CornerRadius="16" Margin="2,4,0,0" Background="#0F000000"/>
        <Border CornerRadius="16" Margin="1,2,0,0" Background="#16000000"/>
        <Border CornerRadius="16" Background="{Binding Theme.GlassBrush}"
                BorderBrush="{Binding Theme.StrokeBrush}" BorderThickness="1">
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部高光反射层 -->
            <Border CornerRadius="16" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3AFFFFFF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="0.4"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ============ 自绘标题栏 ============ -->
            <Grid Grid.Row="0" Height="46" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                  Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="悬浮天气" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextHighBrush}"/>
                    <TextBlock Text=" · 详情" FontSize="11" Foreground="{StaticResource TextFaintBrush}"
                               Margin="6,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="9" Margin="6,0,12,0"
                        VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Close_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33E5484D"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextMidBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ============ 内容区 ============ -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="16,4,16,18">
                <StackPanel>
                    <!-- 实时大卡片 -->
                    <Border CornerRadius="16" Background="{Binding Theme.InnerBrush}"
                            BorderBrush="{Binding Theme.StrokeBrush}" BorderThickness="1"
                            Padding="16,16,16,14">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 大图标徽章 -->
                            <Border Width="76" Height="76" CornerRadius="22"
                                    Background="{Binding Theme.InnerBrush}"
                                    BorderBrush="{Binding Theme.StrokeBrush}" BorderThickness="1"
                                    VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{Binding IconText}" FontFamily="{Binding IconFont}"
                                           FontSize="46" Foreground="{Binding Theme.AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 温度 + 天气 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Temperature}" FontSize="52" FontWeight="Bold"
                                               Foreground="{StaticResource TextHighBrush}"
                                               FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                    <TextBlock Text="{Binding WeatherText}" FontSize="16"
                                               Foreground="{StaticResource TextMidBrush}"
                                               Margin="10,0,0,8" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock Text="{Binding FeelsLike}" FontSize="12"
                                           Foreground="{StaticResource TextLowBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- 体感/风/湿度 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="16,0,0,2">
                                <TextBlock Text="{Binding Detail}" FontSize="12"
                                           Foreground="{StaticResource TextLowBrush}"
                                           TextAlignment="Right" MaxWidth="120" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <!-- 底部：城市 + AQI + 状态 -->
                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CityName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextHighBrush}"/>
                                <Border Margin="8,0,0,0" Padding="7,2" CornerRadius="6"
                                        Background="#26FFFFFF" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Aqi}" FontSize="10"
                                               Foreground="{StaticResource TextMidBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" FontSize="10"
                                       Foreground="{StaticResource TextFaintBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 逐时预报 -->
                    <TextBlock Text="逐时预报" Style="{StaticResource SectionTitle}" Margin="2,16,0,10"/>
                    <Border CornerRadius="14" Background="{Binding Theme.InnerBrush}"
                            BorderBrush="{Binding Theme.StrokeBrush}" BorderThickness="1" Padding="12,10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Hourly}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,0" Width="48">
                                            <TextBlock Text="{Binding Time, StringFormat=HH:mm}" FontSize="11"
                                                       Foreground="{StaticResource TextMidBrush}" HorizontalAlignment="Center"/>
                                            <Border Width="40" Height="40" CornerRadius="13" Margin="0,6,0,4"
                                                    Background="{Binding DataContext.Theme.InnerBrush,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding IconText}" FontFamily="{Binding IconFont}"
                                                           FontSize="22" Foreground="{Binding DataContext.Theme.AccentBrush,
                                                               RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Temp, StringFormat={}{0:0.#}°}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextHighBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Text}" FontSize="10"
                                                       Foreground="{StaticResource TextLowBrush}" HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="46"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 7日预报 -->
                    <TextBlock Text="7日预报" Style="{StaticResource SectionTitle}" Margin="2,16,0,10"/>
                    <Border CornerRadius="14" Background="{Binding Theme.InnerBrush}"
                            BorderBrush="{Binding Theme.StrokeBrush}" BorderThickness="1" Padding="14,12">
                        <ItemsControl ItemsSource="{Binding Daily}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Date, Converter={StaticResource WeekdayConverter}}" FontSize="13"
                                                       Foreground="{StaticResource TextHighBrush}"/>
                                            <TextBlock Text="{Binding Date, StringFormat=MM-dd}" FontSize="10"
                                                       Foreground="{StaticResource TextFaintBrush}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="10"
                                                Background="{Binding DataContext.Theme.InnerBrush,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconText}" FontFamily="{Binding IconFont}"
                                                       FontSize="17" Foreground="{Binding DataContext.Theme.AccentBrush,
                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TempMin, StringFormat={}{0:0.#}°}" FontSize="12"
                                                           Foreground="{StaticResource TextLowBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Height="5" CornerRadius="3" Margin="8,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#4D8DFF" Offset="0"/>
                                                            <GradientStop Color="#4CE0B3" Offset="0.5"/>
                                                            <GradientStop Color="#FFC966" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding TempMax, StringFormat={}{0:0.#}°}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextHighBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Text}" FontSize="11"
                                                       Foreground="{StaticResource TextMidBrush}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 生活指数 -->
                    <TextBlock Text="生活指数" Style="{StaticResource SectionTitle}" Margin="2,16,0,10"/>
                    <ItemsControl ItemsSource="{Binding Indices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="12,10" CornerRadius="12"
                                        Background="{Binding DataContext.Theme.InnerBrush,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        BorderBrush="{Binding DataContext.Theme.StrokeBrush,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextHighBrush}"/>
                                            <Border Margin="6,0,0,0" Padding="5,1" CornerRadius="5"
                                                    Background="#264C8DFF" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Level}" FontSize="9"
                                                           Foreground="#BBD6FF"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="11"
                                                   Foreground="{StaticResource TextLowBrush}"
                                                   Margin="0,5,0,0" TextWrapping="Wrap" MaxHeight="34"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 加载提示 -->
                    <TextBlock Text="加载中…" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                               HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Border>
    </Grid>
</Window>
