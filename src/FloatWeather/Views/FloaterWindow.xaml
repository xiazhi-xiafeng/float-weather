<Window x:Class="FloatWeather.Views.FloaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="悬浮天气"
        Width="272" Height="118"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        Opacity="{Binding Opacity}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        MouseEnter="Floater_MouseEnter"
        MouseLeave="Floater_MouseLeave">
    <Grid>
        <!-- ============ 主玻璃卡片 ============ -->
        <Grid Margin="6,4,8,10">
            <!-- 柔和投影：多层半透明圆角，替代 DropShadowEffect（避免透明窗口的灰色直角） -->
            <Border CornerRadius="18" Margin="2,4,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#0F000000"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBare}" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border CornerRadius="18" Margin="1,2,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#16000000"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBare}" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <Border x:Name="Card" CornerRadius="18"
                    MouseLeftButtonDown="DragMove_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding Theme.GlassBrush}"/>
                        <Setter Property="BorderBrush" Value="{Binding Theme.StrokeBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBare}" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            <Grid ClipToBounds="True">
                <!-- 顶部高光反射层（玻璃质感） -->
                <Border CornerRadius="18" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#42FFFFFF" Offset="0"/>
                                        <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBare}" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <!-- Bare 桌面直显：无任何外发光/阴影，文字直接以深色浮在桌面上，避免白晕造成"框"感与小字发虚 -->
                <Grid Margin="14,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 天气图标徽章 -->
                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="16"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding Theme.InnerBrush}"/>
                                <Setter Property="BorderBrush" Value="{Binding Theme.StrokeBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBare}" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding IconText}" FontFamily="{Binding IconFont}"
                                   FontSize="32" Foreground="{Binding IconBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 温度 + 描述 + 状态 -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TempText" Text="{Binding Temperature, NotifyOnTargetUpdated=True}" FontSize="30" FontWeight="SemiBold"
                                       Foreground="{Binding FgHigh}" VerticalAlignment="Bottom"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <TextBlock Grid.Column="1" Text="{Binding WeatherText}" FontSize="13"
                                       Foreground="{Binding FgMid}" Margin="8,0,0,4"
                                       VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding CityName}" FontSize="12" Foreground="{Binding FgLow}"/>
                            <!-- 湿度：数据源未提供（为 0）时整体隐藏 -->
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHumidity}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text=" · " FontSize="12" Foreground="{Binding FgFaint}"/>
                                <TextBlock Text="{Binding Humidity}" FontSize="12" Foreground="{Binding FgLow}"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- 状态行：始终显示数据源与更新时间（不再随是否有逐时隐藏） -->
                        <TextBlock Grid.Row="2" FontSize="10" Foreground="{Binding FgFaint}" Margin="0,3,0,0"
                                   Text="{Binding Status}"/>
                    </Grid>

                    <!-- 展开详情按钮 -->
                    <Border Grid.Column="2" Width="30" Height="30" CornerRadius="15"
                            VerticalAlignment="Center" Cursor="Hand" Margin="4,0,0,0"
                            MouseLeftButtonDown="OpenDetail_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding Theme.InnerBrush}"/>
                                <Setter Property="BorderBrush" Value="{Binding Theme.StrokeBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Opacity" Value="0.75"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsBare}" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="›" FontSize="20" FontWeight="Bold"
                                   Foreground="{Binding IconBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="1,-1,0,0"/>
                    </Border>
                </Grid>
            </Grid>
            </Border>
        </Grid>

        <!-- ============ 悬停逐时浮层 ============ -->
        <Popup x:Name="HourlyPopup" Placement="Top" PlacementTarget="{Binding ElementName=Root}"
               StaysOpen="True" AllowsTransparency="True" IsOpen="False"
               PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="-10">
            <Grid Margin="6,4,8,8">
                <Border CornerRadius="14" Margin="2,4,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#0F000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBare}" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border CornerRadius="14" Margin="1,2,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#16000000"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBare}" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border CornerRadius="14" Padding="12" MaxHeight="280" MinWidth="228">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding Theme.GlassBrush}"/>
                            <Setter Property="BorderBrush" Value="{Binding Theme.StrokeBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBare}" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#26000000"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding CityName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding FgMid}"/>
                        <TextBlock Text="逐时预报" FontSize="10" Foreground="{Binding FgFaint}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ScrollViewer Style="{StaticResource GlassScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Hourly}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontSize="13" Foreground="{Binding DataContext.FgMid,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IconText}"
                                                   FontFamily="{Binding IconFont}"
                                                   FontSize="17" Foreground="{Binding DataContext.IconBrush,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Temp}"
                                                   FontSize="13" Foreground="{Binding DataContext.FgHigh,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AqiText}"
                                                   FontSize="11" Foreground="{Binding DataContext.IconSoftBrush,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   TextAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Window>
